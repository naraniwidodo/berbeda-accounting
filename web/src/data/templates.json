{
  "templates": [
    {
      "id": "A1",
      "group": "Sales",
      "label": "Sales - Down Payment",
      "description": "Books the deposit, recognises the revenue and raises the invoice in one entry. That is how the source ledger records a sale: 20 of 21 projects post all three on the same date.",
      "seen": 23,
      "sku": "required",
      "stage": 1,
      "opens": "prepayment_client",
      "detail_from": "Revenue",
      "detail_default": "Jasa Lukis",
      "inputs": [
        {
          "name": "dp_amount",
          "label": "Down payment received",
          "type": "money"
        },
        {
          "name": "project_value",
          "label": "Total project value",
          "type": "money"
        }
      ],
      "lines": [
        {
          "side": "Dr",
          "account": "Cash/Bank",
          "amount": "dp_amount"
        },
        {
          "side": "Cr",
          "account": "Prepayment Client",
          "amount": "dp_amount"
        },
        {
          "side": "Dr",
          "account": "Accrued Revenue",
          "amount": "project_value"
        },
        {
          "side": "Cr",
          "account": "Revenue",
          "amount": "project_value"
        },
        {
          "side": "Dr",
          "account": "Account Receivable",
          "amount": "project_value"
        },
        {
          "side": "Cr",
          "account": "Accrued Revenue",
          "amount": "project_value",
          "note": "Accrued Revenue nets to zero - it is the bridge between recognising and invoicing"
        }
      ]
    },
    {
      "id": "A4",
      "group": "Sales",
      "label": "Sales - Down Payment Final Settlement",
      "seen": 13,
      "sku": "required",
      "stage": 4,
      "closes": "prepayment_client",
      "detail_from": "Revenue",
      "detail_default": "Jasa Lukis",
      "inputs": [
        {
          "name": "cash_received",
          "label": "Cash received",
          "type": "money"
        }
      ],
      "context": [
        {
          "name": "dp_open",
          "label": "Open DP on this SKU",
          "source": "ledger",
          "readonly": true
        }
      ],
      "lines": [
        {
          "side": "Dr",
          "account": "Cash/Bank",
          "amount": "cash_received"
        },
        {
          "side": "Dr",
          "account": "Prepayment Client",
          "amount": "dp_open",
          "auto": true,
          "note": "Filled from the open DP balance. Cannot be edited or omitted."
        },
        {
          "side": "Cr",
          "account": "Account Receivable",
          "amount": "cash_received + dp_open"
        }
      ],
      "description": "The client pays the rest of an order that began with a down payment. Pick the project and the open deposit is cleared automatically. No revenue is recognised here - it was recognised in full when the deposit was taken."
    },
    {
      "id": "A5",
      "group": "Sales",
      "label": "Sales - Full Payment (No Down Payment)",
      "seen": 2,
      "sku": "optional",
      "detail_from": "Revenue",
      "detail_default": "Jasa Lukis",
      "inputs": [
        {
          "name": "amount",
          "label": "Amount paid in full",
          "type": "money"
        }
      ],
      "lines": [
        {
          "side": "Dr",
          "account": "Accrued Revenue",
          "amount": "amount"
        },
        {
          "side": "Cr",
          "account": "Revenue",
          "amount": "amount"
        },
        {
          "side": "Dr",
          "account": "Account Receivable",
          "amount": "amount"
        },
        {
          "side": "Cr",
          "account": "Accrued Revenue",
          "amount": "amount"
        },
        {
          "side": "Dr",
          "account": "Cash/Bank",
          "amount": "amount"
        },
        {
          "side": "Cr",
          "account": "Account Receivable",
          "amount": "amount",
          "note": "Accrued Revenue and Account Receivable both net to zero - they are the recognise-then-invoice bridge the ledger keeps"
        }
      ],
      "description": "Paid in full with no deposit. Recognises the revenue, raises the invoice and settles it in one entry - the same three steps as a deposit sale, all on the same day."
    },
