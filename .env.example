# Copy this file to .env in the project root and fill in your own key.
# .env is gitignored. Never commit a real key.

PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_PROVIDER=openai

# Optional. Ceilings for one chat question. Set a value to "none" to lift it.
# CHAT_TOTAL_TOKENS_LIMIT=60000
# CHAT_OUTPUT_TOKENS_LIMIT=2000
# CHAT_REQUEST_LIMIT=8
# CHAT_TOOL_CALLS_LIMIT=10
